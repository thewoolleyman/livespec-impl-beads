{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "livespec.beads_v112_rehearsal.shape_survey_receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "measured_at",
    "sources"
  ],
  "properties": {
