# Source template for the Fabro dark-factory systemd unit.
#
# This file is NOT installed directly. install.sh renders it by substituting
# every @NAME@ placeholder from the selected hosts/<host>.env file, and writes
# the result to /etc/systemd/system/fabro-server.service.
#
# Placeholders are the axes on which real hosts diverge. They were derived by
# diffing the two live factories (vps, hp-xubuntu) on 2026-08-19, not guessed:
# the vps-era runbook predicted only two, and the true count is five.
[Unit]
Description=Fabro dark-factory server and web console
Documentation=https://github.com/thewoolleyman/fabro
After=network-online.target docker.service tailscaled.service
Wants=network-online.target docker.service tailscaled.service

[Service]
Type=simple
User=@FABRO_HOST_USER@
Group=@FABRO_HOST_GROUP@
Environment=HOME=@FABRO_HOST_HOME@
# Cold SlateDB warmup under host load can exceed the verifier's default 60s
# budget, which makes ExecStartPost fail, which makes Restart=always kill a
# half-booted server -- a self-reinforcing crash loop that does not recover.
# Observed on vps 2026-08-17 (killed run fabro-run-01M06K2HZ6YNG6BWJ03HP696PT,
# exit 137). See bd-ib-l3nptz.2 and bd-ib-l3nptz.15.
Environment=FABRO_WEB_VERIFY_ATTEMPTS=@FABRO_WEB_VERIFY_ATTEMPTS@
# Supplied to ExecStartPost's verifier so ONE shared verifier script serves
# every host. Without this the script falls back to its vps-shaped default and
# each host needs its own forked copy.
Environment=FABRO_CANONICAL_HOST=@FABRO_CANONICAL_HOST@
EnvironmentFile=@FABRO_HOST_HOME@/.fabro/storage/server.env
# OAuth-only posture: the agent's model auth is CLAUDE_CODE_OAUTH_TOKEN,
# injected into the sandbox per dispatch. An API key in the SERVER env bills
# API cost and can leak into the sandbox.
UnsetEnvironment=ANTHROPIC_API_KEY OPENAI_API_KEY
WorkingDirectory=@FABRO_HOST_CHECKOUT@
ExecStart=@FABRO_HOST_HOME@/.fabro/bin/fabro server start --foreground --bind 127.0.0.1:32276 --web --no-upgrade-check
ExecStartPost=/usr/local/libexec/fabro-server-verify-web
Restart=always
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
