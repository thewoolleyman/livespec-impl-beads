# Per-host values for the hp-xubuntu node (Ubuntu 26.04, 16 cores, 30Gi RAM).
# Measured from the live host 2026-08-19 over `tailscale ssh cwoolley@hp-xubuntu`.
#
# NOTE the service account is cwoolley, NOT ubuntu -- the tailnet ACL rejects
# the ubuntu account on this host, and the checkout root is under $HOME rather
# than /data/projects.
FABRO_HOST_USER=cwoolley
FABRO_HOST_GROUP=cwoolley
FABRO_HOST_HOME=/home/cwoolley
FABRO_HOST_CHECKOUT=/home/cwoolley/repos/livespec-orchestrator-beads-fabro
FABRO_CANONICAL_HOST=hp-xubuntu.perch-rudd.ts.net:32276
# hp currently runs the unmitigated default of 60; 300 here is bd-ib-l3nptz.15's fix.
FABRO_WEB_VERIFY_ATTEMPTS=300
FABRO_CLI_TARGET_URL=http://127.0.0.1:32276
