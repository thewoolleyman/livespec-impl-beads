# Expected RESOLVED fabro server settings for vps, as reported by
# GET /api/v1/settings. Measured live 2026-08-19.
#
# These are behavior, not file contents: a value may be resolved from
# ~/.fabro/settings.toml or from fabro's built-in defaults, and the point of
# this file is to notice when a host silently falls back to a default.
server.scheduler.max_concurrent_runs=10
server.web.enabled=true
server.web.url=https://vps.perch-rudd.ts.net:32276
server.api.url=https://vps.perch-rudd.ts.net:32276/api/v1
server.listen.address=127.0.0.1:32276
server.integrations.github.app_id=3668528
