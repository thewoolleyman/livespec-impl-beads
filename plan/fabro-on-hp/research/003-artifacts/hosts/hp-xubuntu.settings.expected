# Expected RESOLVED fabro server settings for hp-xubuntu, as reported by
# GET /api/v1/settings. Measured live 2026-08-19.
#
# max_concurrent_runs: hp currently resolves 5 -- the fabro built-in default
# (lib/crates/fabro-config/src/defaults.toml:44 at the pinned build 8de6611),
# because hp's settings.toml has no [server.scheduler] table at all. vps runs
# 10. That divergence is bd-ib-l3nptz.16 and is UNRESOLVED: the value below is
# deliberately left at the observed 5 so this file records what IS, not what
# someone hopes. Change it in the same commit that changes the host.
#
# Do NOT simply copy vps's 10. Measured on hp 2026-08-19 under four live runs:
# the per-run plan is docker-ENFORCED at cpu=4 / memory=8GB, but actual usage
# was 245-659MiB against the 7.451GiB cap and CPU was the busier axis. So the
# 8GB is a cap, not a reservation, and the right number follows from measured
# idleness and vps's ~2.2x over-subscription factor (which would put hp near
# 8-10), not from nominal reservation arithmetic. Measure before choosing.
server.scheduler.max_concurrent_runs=5
server.web.enabled=true
server.web.url=https://hp-xubuntu.perch-rudd.ts.net:32276
server.api.url=https://hp-xubuntu.perch-rudd.ts.net:32276/api/v1
server.listen.address=127.0.0.1:32276
server.integrations.github.app_id=3668528
