#!/bin/sh
# This repository's own commit-blocking hook, written in POSIX sh and git alone.
#
# `SPECIFICATION/contracts.md`, the sandbox commit-refuse exemption resolution,
# obliges a governed repository's commit-blocking hooks to HONOR the resolved
# sandbox-exemption marker: a Fabro sandbox is a fresh full clone, structurally
# indistinguishable from a primary checkout, so this hook's primary-checkout
# refusal would otherwise refuse the sandbox's own Red-Green-Replay commits.
# When the resolved marker key reads `true` in the sandbox's git config the
# refusal is suspended -- and only that refusal, because every gate this hook
# delegates still fires.
#
# The key is read LITERALLY. That is why the schema closes
# `dispatcher.sandbox_exempt_marker` to a single value: a declared alternate
# would be set by the orchestrator's projection and honored by nothing here.
set -eu

exempt=$(git config --get --bool livespec.sandboxExempt || printf 'false')
if [ "$exempt" = true ]; then
    exec "$(dirname "$0")/red-green-replay-gate"
fi

printf '%s\n' "refusing: commits are not made in the primary checkout" >&2
exit 1
